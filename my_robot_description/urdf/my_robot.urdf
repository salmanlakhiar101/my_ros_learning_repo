<?xml version="1.0"?>

<robot name="my_robot">
    <!-- ==================== MATERIALS ==================== -->

    <material name="gray">
    <color rgba="0.75 0.75 0.78 1.0"/>
    </material>
    
    <material name="blue">
    <color rgba="0.18 0.35 0.58 1.0"/>
    </material>
    
    <material name="flange_steel">
    <color rgba="0.3 0.3 0.3 1.0"/>
    </material>


    <!-- ==================== LINKS & Joints  ==================== -->

    <!-- ==================== Base Link ==================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
    </link>

    <link name="base_footprint"/>

    <joint name="origin_link" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- ==================== Left Wheel ==================== -->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="flange_steel"/>
        </visual>
    </link>

    <!-- Base to Left Wheel Joint -->
    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.15 -0.225 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ==================== Right Wheel ==================== -->
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="flange_steel"/>
        </visual>
    </link>

    <!-- Base to right Wheel Joint -->
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.15 0.225 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ==================== Front Wheel ==================== -->
    <link name="front_wheel">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="flange_steel"/>
        </visual>
    </link>

    <!-- Base to front Wheel Joint -->
    <joint name="base_front_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_wheel"/>
        <origin xyz="0.15 0 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


</robot>